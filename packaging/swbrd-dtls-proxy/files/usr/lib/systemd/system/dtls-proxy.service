[Unit]
Description=DTLS proxy that uses destination IP+port as the connection id
Documentation=https://github.com/evan-brass/swbrd
Wants=network-online.target
After=network-online.target systemd-networkd.service
# Rate limit for the Restart= below; these two keys belong to [Unit].
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=exec
User=swbrd
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
StateDirectory=swbrd
WorkingDirectory=/var/lib/swbrd
EnvironmentFile=/etc/default/swbrd-dtls-proxy
ExecStart=/usr/libexec/swbrd/dtls-proxy $DTLS_PROXY_ARGS

# The release profile aborts on panic, so without this a single bug takes the
# service down until someone notices.  The burst limit keeps a genuinely broken
# build from hiding in a restart loop: five failures in a minute and it stays
# down, which is what the deploy check should see.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
