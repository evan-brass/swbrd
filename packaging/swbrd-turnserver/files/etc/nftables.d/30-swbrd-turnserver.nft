#!/usr/sbin/nft -f
# swbrd-turnserver.  Declare-delete-define: applying this file replaces exactly
# table inet turn_acct and leaves every other table alone.
#
# Per-client byte/packet accounting for the turnserver's :3478 control+relay
# sockets.  `update` both inserts and refreshes an element's timeout, so active
# clients keep accumulating on a rolling window and idle ones age out on their
# own -- no separate cleanup needed.

table inet turn_acct {}
delete table inet turn_acct
table inet turn_acct {
	set in4 {
		type ipv4_addr
		size 4096
		flags dynamic, timeout
		timeout 1h
		counter
	}
	set in6 {
		type ipv6_addr
		size 4096
		flags dynamic, timeout
		timeout 1h
		counter
	}
	set out4 {
		type ipv4_addr
		size 4096
		flags dynamic, timeout
		timeout 1h
		counter
	}
	set out6 {
		type ipv6_addr
		size 4096
		flags dynamic, timeout
		timeout 1h
		counter
	}
	# `filter + 10` rather than a bare `filter`: swbrd-common's santa table also
	# hooks at filter, and equal-priority base chains run in registration order,
	# which after the split depends on which fragment was reloaded last.  The
	# explicit offset keeps santa's naughty-list reject ahead of the counters no
	# matter what order the two packages were installed or reloaded in.
	chain input {
		type filter hook input priority filter + 10;
		tcp dport 3478 update @in4 { ip  saddr counter }
		tcp dport 3478 update @in6 { ip6 saddr counter }
		udp dport 3478 update @in4 { ip  saddr counter }
		udp dport 3478 update @in6 { ip6 saddr counter }
	}
	chain output {
		type filter hook output priority filter + 10;
		tcp sport 3478 update @out4 { ip  daddr counter }
		tcp sport 3478 update @out6 { ip6 daddr counter }
		udp sport 3478 update @out4 { ip  daddr counter }
		udp sport 3478 update @out6 { ip6 daddr counter }
	}
}
