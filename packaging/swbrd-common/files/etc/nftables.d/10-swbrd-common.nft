#!/usr/sbin/nft -f
# swbrd-common.  Declare-delete-define: `nft -f` on this file replaces exactly
# the tables named here and leaves every other table in the ruleset alone.  The
# empty declaration exists so the delete cannot fail on a fresh ruleset.

table inet santa {}
delete table inet santa
table inet santa {
	# Keep a naughty list of ips that we've sent more than 40 rst in 1 min
	set naughty_list {
		type ipv4_addr
		size 300
		flags timeout
	}
	set rst_meter {
		type ipv4_addr
		size 100
		flags dynamic, timeout
		timeout 2m
	}
	chain input {
		type filter hook input priority filter;
		ip saddr 127.0.0.0/8 accept
		ip saddr @naughty_list reject
	}
	chain output {
		type filter hook output priority filter;
		# Everything nginx proxies takes a second trip over loopback, and tearing those
		# connections down is a normal source of rst.  Without this, ~20 proxied connections
		# put 127.0.0.1 on the naughty list, and the input chain then rejects the server's
		# own upstream traffic for 30 minutes.
		ip daddr 127.0.0.0/8 return
		tcp flags rst \
		update @rst_meter { ip daddr limit rate over 40/minute burst 40 packets } \
		add @naughty_list { ip daddr timeout 60m }
	}
}

# Diverts packets that match an existing IP_TRANSPARENT socket to fwmark 2, which
# 70-swbrd-transparent.network routes to the local table.  Shared: nginx's
# `proxy_bind $remote_addr transparent` and dtls-proxy's per-connection sockets
# both depend on it, which is why it lives here and not in either daemon.
table inet transparent {}
delete table inet transparent
table inet transparent {
	chain divert1 {
		type filter hook prerouting priority -150;
		socket transparent 1 meta mark set 2 accept
	}
	chain divert2 {
		type route hook output priority -150;
		ip  saddr 127.0.0.0/8 ip  daddr != 127.0.0.0/8 meta mark set 2 accept
		ip6 saddr ::1         ip6 daddr != ::1         meta mark set 2 accept
	}
}
