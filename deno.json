{
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.2"
	},
	"fmt": {
		"useTabs": true
	},
	"tasks": {
		"start": "deno run --allow-net --unstable-net --allow-read server/main.js",
		"dev": "deno run --inspect --watch --allow-net --unstable-net --allow-read server/main.js",
		"build": "docker run -v ./server/dist:/build/dist $(docker build -q -f build/Dockerfile .)"
	}
}
